      "disclosure": "public",
      "links": [
       {
        "label": "Enlace 10",
        "url": "https://[::g]/"
       },
       {
        "label": "Enlace 11",
        "url": "HTTPS://EXAMPLE.TEST/Ruta"
       },
       {
        "label": "Enlace 12",
        "url": "https://example.test:8443/a?b=[c]#frag"
       },
       {
