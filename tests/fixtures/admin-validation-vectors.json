{
 "note": "Fictional documents (Ada Ejemplo). Validation vectors use root `es`; parity paths carry no language prefix. Shared by the fake API and the editor validator.",
 "validation": [
  {
   "name": "services: a valid document",
   "kind": "services",
   "document": {
    "services": [
     {
      "id": "web",
      "title": "Web de ejemplo",
      "summary": "Resumen ficticio",
      "price": {
       "from": 1500,
       "currency": "EUR"
      }
     },
     {
      "id": "api",
      "title": "Web de ejemplo",
      "summary": "Resumen ficticio",
      "price": null
     }
    ]
   },
   "expected": []
  },
  {
   "name": "services: an empty or missing list is valid",
   "kind": "services",
   "document": {},
   "expected": []
  },
  {
   "name": "services: not a list",
   "kind": "services",
   "document": {
    "services": {}
   },
   "expected": [
    {
     "path": "es.services",
     "code": "INVALID_VALUE"
    }
   ]
  },
  {
   "name": "services: unknown field at the root and in an item",
   "kind": "services",
   "document": {
    "extra": 1,
    "services": [
     {
      "id": "web",
      "title": "Web de ejemplo",
      "summary": "Resumen ficticio",
      "colour": "red"
     }
    ]
   },
   "expected": [
    {
     "path": "es.extra",
     "code": "UNKNOWN_FIELD"
    },
    {
     "path": "es.services[0].colour",
     "code": "UNKNOWN_FIELD"
    }
   ]
  },
  {
   "name": "services: an empty item lacks id, title and summary",
   "kind": "services",
   "document": {
    "services": [
     {}
    ]
   },
   "expected": [
    {
     "path": "es.services[0].id",
     "code": "REQUIRED"
    },
    {
     "path": "es.services[0].title",
     "code": "REQUIRED"
    },
    {
     "path": "es.services[0].summary",
     "code": "REQUIRED"
    }
   ]
  },
  {
   "name": "services: a blank title is missing",
