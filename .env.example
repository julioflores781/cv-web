# Base URL of the CV API (public), read by the server on every request. Default: http://cv-api:8080.
CV_API_URL=http://cv-api:8080
# Public origin of this site, used for canonical, hreflang, sitemap, robots, Open Graph and JSON-LD. Read at runtime. Default: https://floreslab.dev.
SITE_URL=https://floreslab.dev
